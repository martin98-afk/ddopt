# .gitignore (auto-generated by assistant_hub project_notes hook)
# 按需调整即可。

# ── Python 生态 ──
__pycache__/
*.pyc
*.pyo
.venv/
.venv-model/
venv/
# ── 模型数据缓存（npz，由 data_loader.py 生成，可重建）──
.cache/
.cache_old/
# ── 标定集缓存（切换数据集时隔离用）──
.cache_calib/
*.egg-info/
*.egg
build/
dist/
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 服务配置（含鉴权令牌，不入仓库；从 config.example.yaml 复制）──
模型/config.yaml
模型_预测PI/config.yaml

# ── 闭环/对比产出的曲线数据（可由脚本重跑生成）──
模型_预测PI/*.json

# ── 原始数据库（约 20MB，不入仓库；新数据放入后用 build_data.py 重跑即可）──
脱硫脱硝消石灰制备数据/*.zip

# ── 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── IDE/编辑器 ──
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
.project
.pycpath
